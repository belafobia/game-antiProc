# Copie este arquivo para .env e preencha com os valores reais.
# O .env NÃO vai para o git; este arquivo vai.

# Conexão com o Postgres (Neon). Use a conexão direta (sem "-pooler" no host)
# e o prefixo postgresql+psycopg:// para o SQLAlchemy usar o driver psycopg 3.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST/BANCO?sslmode=require

# Segredo que assina os tokens de login. Gere um valor aleatório com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Trocar este valor desloga todo mundo (os tokens antigos deixam de valer).
JWT_SECRET=troque-por-um-valor-aleatorio

# Opcionais (os valores abaixo já são o padrão):
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080
# Sites que podem chamar a API pelo navegador (lista em JSON).
# Em produção, coloque a URL da Vercel:
# CORS_ORIGINS=["http://localhost:5173"]
